---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada">
  <section class="container-site flex min-h-[80svh] flex-col items-center justify-center pt-20 text-center">
    <h1 class="text-4xl text-white sm:text-5xl">Esta página não existe.</h1>
    <p class="mt-4 text-lavanda/70">Mas os nossos agentes continuam trabalhando.</p>
    <a href="/" class="btn-primario mt-8">Voltar ao início</a>
  </section>
</Base>
