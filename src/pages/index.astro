---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ParticleField from '../components/ParticleField.astro';
import Glifo from '../components/Glifo.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { AGENDA_URL } from '../consts';
import { produtos } from '../data/produtos';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

const comparacao = [
  ['Prompts soltos, cada um na sua ferramenta', 'Agentes ligados aos processos e aos sistemas'],
  ['Chatbot genérico', 'Agentes que agendam, respondem e consultam o estoque'],
  ['Dados espalhados em sistemas que não conversam', 'Um centro de dados onde o histórico nunca se perde'],
  ['Experimentos que não viram rotina', 'Equipe treinada e adoção acompanhada'],
  ['Só quem sabe usar se beneficia', 'Para todos na empresa'],
];

const passos = [
  { n: '01', t: 'Diagnóstico', d: 'Entendemos sua operação e encontramos onde os agentes trazem mais resultado.' },
  { n: '02', t: 'Agentes sob medida', d: 'Construímos e conectamos os agentes aos seus sistemas, sem começar do zero.' },
  { n: '03', t: 'Equipe preparada', d: 'Sua equipe aprende a trabalhar com eles: delegar, revisar e propor os próximos.' },
  { n: '04', t: 'Evolução contínua', d: 'Acompanhamos todo mês. Cada agente novo amplia o que a empresa consegue fazer.' },
];

const fmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base>
  <!-- 1. Hero -->
  <section class="relative isolate flex min-h-[92svh] items-center overflow-hidden">
    <ParticleField />
    <div class="pointer-events-none absolute inset-0 -z-0 bg-gradient-to-b from-marinho/0 via-marinho/0 to-marinho"></div>
    <div class="container-site relative pt-28 pb-20">
      <h1 class="max-w-4xl text-[2.6rem] leading-[1.05] text-white sm:text-6xl lg:text-7xl">
        Sua empresa já usa IA.<br />
        <span class="text-ciano">Agora falta a cultura.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-lavanda/85 sm:text-xl">
        Cultura agêntica é quando agentes de IA trabalham junto com a sua equipe, ligados aos seus sistemas, aos seus dados e à rotina do negócio. A Agentical constrói isso sob medida para a sua empresa.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={AGENDA_URL} class="btn-primario">Agendar conversa</a>
        <a href="/manifesto" class="btn-secundario">Leia o manifesto</a>
      </div>
    </div>
  </section>

  <!-- 2. A vs ∀ -->
  <section class="relative">
    <div class="container-site py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">A vs ∀</p>
        <h2 class="mt-4 text-3xl text-white sm:text-5xl">Usar IA não é o mesmo que ter cultura agêntica.</h2>
      </div>

      <div class="mt-14 overflow-hidden rounded-2xl border border-lavanda/10">
        <div class="grid grid-cols-2 bg-noite">
          <div class="flex items-center gap-3 p-5 sm:p-7">
            <Glifo tipo="A" class="h-6 w-auto text-lavanda/60" />
            <span class="font-display text-lg text-lavanda/70 sm:text-xl">Usar IA</span>
          </div>
          <div class="flex items-center gap-3 border-l border-lavanda/10 p-5 sm:p-7">
            <Glifo tipo="V" class="h-6 w-auto text-ciano" />
            <span class="font-display text-lg text-white sm:text-xl">Cultura agêntica</span>
          </div>
        </div>
        {comparacao.map(([a, v], i) => {
          const ultima = i === comparacao.length - 1;
          return (
            <div class:list={['grid grid-cols-2 border-t border-lavanda/10 text-sm sm:text-base', ultima && 'bg-ciano/[0.06]']}>
              <p class="p-5 text-lavanda/55 sm:p-7">{a}</p>
              <p class:list={['border-l border-lavanda/10 p-5 sm:p-7', ultima ? 'font-medium text-ciano' : 'text-lavanda']}>{v}</p>
            </div>
          );
        })}
      </div>

      <p class="mt-8 max-w-2xl text-lavanda/70">
        No logo da Agentical, o último A está de ponta-cabeça: <span class="text-ciano">∀</span>, o símbolo matemático de "para todo". É a nossa promessa: IA agêntica para todas as empresas, e para todas as pessoas dentro delas.
        <a href="/manifesto" class="whitespace-nowrap text-ciano underline-offset-4 hover:underline">Leia o manifesto →</a>
      </p>
    </div>
  </section>

  <!-- 3. As seis partes da cultura agêntica -->
  <section class="bg-noite py-24">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow">Produtos</p>
        <h2 class="mt-4 text-3xl text-white sm:text-5xl">As seis partes da cultura agêntica.</h2>
        <p class="mt-5 text-lg text-lavanda/75">Cada produto Agentical transforma uma parte da empresa. Juntos, viram uma só cultura.</p>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {produtos.map((p) => (
          <a href={`/produtos/${p.slug}`} class:list={[
            'group relative flex flex-col rounded-2xl border p-7 transition',
            p.destaque ? 'border-ciano/50 bg-ciano/[0.07] hover:border-ciano' : 'border-lavanda/10 bg-marinho/60 hover:border-lavanda/40',
          ]}>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-[0.18em] text-lavanda/50">{p.parte}</span>
              {p.destaque && <span class="rounded-full bg-ciano px-2.5 py-1 text-[11px] font-medium text-marinho">{p.destaque}</span>}
            </div>
            <h3 class="mt-6 text-2xl text-white"><span class="text-lavanda/50">Agentical</span> {p.nome}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-lavanda/75">{p.chamada}</p>
            <span class="mt-6 text-sm text-ciano opacity-80 transition group-hover:translate-x-1 group-hover:opacity-100">Conhecer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Cockpit -->
  <section class="py-24">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Agentical Cockpit</p>
        <h2 class="mt-4 text-4xl text-white sm:text-6xl">Veja, converse, aja.</h2>
        <p class="mt-6 text-lg leading-relaxed text-lavanda/80">
          Um só lugar para ver o que acontece na empresa, conversar sobre isso e colocar os agentes para agir. Com login único e ligado aos seus sistemas reais.
        </p>
        <ul class="mt-8 space-y-4 text-lavanda/80">
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ciano"></span>Pergunte em português, como falaria com um gerente.</li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ciano"></span>Troque de ERP sem perder o histórico: os indicadores mantêm a mesma curva.</li>
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ciano"></span>Cada agente novo aparece ali e amplia o que a conversa sabe.</li>
        </ul>
        <a href="/produtos/cockpit" class="btn-secundario mt-10">Conhecer o Cockpit</a>
      </div>

      <!-- Ilustração de conversa (exemplo) -->
      <figure class="rounded-2xl border border-lavanda/10 bg-noite p-5 shadow-2xl shadow-black/30 sm:p-7">
        <div class="flex items-center justify-between border-b border-lavanda/10 pb-4">
          <span class="flex items-center gap-1 text-ciano"><Glifo tipo="A" class="h-3.5 w-auto" /><Glifo tipo="V" class="-ml-1 h-3.5 w-auto" /><span class="ml-2 font-display text-sm text-lavanda">Cockpit</span></span>
          <span class="text-[11px] uppercase tracking-widest text-lavanda/40">exemplo</span>
        </div>
        <div class="mt-6 space-y-5 text-sm">
          <p class="ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-ciano px-4 py-3 text-marinho">Como foram as vendas de 2019 comparadas com hoje?</p>
          <div class="max-w-[92%] rounded-2xl rounded-bl-sm border border-lavanda/10 bg-marinho px-4 py-4 text-lavanda/90">
            <p>Juntei os dados do ERP antigo e do atual na mesma régua. As vendas cresceram no período, com o maior salto depois que o atendimento passou a responder pelo WhatsApp.</p>
            <svg viewBox="0 0 240 70" class="mt-4 h-auto w-full" aria-hidden="true">
              <line x1="0" y1="69" x2="240" y2="69" stroke="#646eb4" stroke-opacity=".4" />
              <line x1="132" y1="0" x2="132" y2="69" stroke="#646eb4" stroke-opacity=".5" stroke-dasharray="2 3" />
              <polyline fill="none" stroke="#00d1ff" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="0,52 24,49 48,54 72,44 96,46 120,40 144,34 168,28 192,24 216,14 240,10" />
              <text x="128" y="10" text-anchor="end" fill="#e6e6fa" fill-opacity=".5" font-size="8">troca de ERP</text>
            </svg>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full border border-lavanda/15 px-3 py-1.5 text-xs text-lavanda/70">Gerar relatório</span>
            <span class="rounded-full border border-lavanda/15 px-3 py-1.5 text-xs text-lavanda/70">Comparar por loja</span>
          </div>
        </div>
        <figcaption class="sr-only">Exemplo ilustrativo de uma conversa no Agentical Cockpit.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. Como começa -->
  <section class="border-t border-lavanda/10 py-24">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow">Como trabalhamos</p>
        <h2 class="mt-4 text-3xl text-white sm:text-5xl">Cultura não se instala. Se constrói junto.</h2>
        <p class="mt-5 text-lg text-lavanda/75">Tudo começa pelo <a href="/produtos/culture" class="text-ciano underline-offset-4 hover:underline">Agentical Culture</a>. A partir daí, cada passo é sob medida.</p>
      </div>
      <ol class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-lavanda/10 bg-lavanda/10 sm:grid-cols-2 lg:grid-cols-4">
        {passos.map((s) => (
          <li class="bg-marinho p-7">
            <span class="font-display text-sm text-ciano">{s.n}</span>
            <h3 class="mt-4 text-xl text-white">{s.t}</h3>
            <p class="mt-3 text-sm leading-relaxed text-lavanda/70">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Para todas as empresas -->
  <section class="bg-lavanda py-24 text-marinho">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <Glifo tipo="V" class="h-12 w-auto text-marinho" />
        <h2 class="mt-6 text-3xl sm:text-5xl">Para todas as empresas. Não só para as grandes.</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2">
        <div><h3 class="text-lg">Sob medida</h3><p class="mt-2 text-sm leading-relaxed text-marinho/75">Feito para os seus processos, sem o custo e a complexidade de projetos pensados para grandes corporações.</p></div>
        <div><h3 class="text-lg">Ligado ao que você já tem</h3><p class="mt-2 text-sm leading-relaxed text-marinho/75">ERP, agenda, WhatsApp e site conectados. Ninguém precisa trocar de sistema para começar.</p></div>
        <div><h3 class="text-lg">Seus dados sob controle</h3><p class="mt-2 text-sm leading-relaxed text-marinho/75">Os dados ficam organizados no servidor da solução, com a anuência da sua TI. Só o necessário vai para a IA. <a href="/privacidade" class="underline underline-offset-4">Saiba mais</a></p></div>
        <div><h3 class="text-lg">Atendimento próximo</h3><p class="mt-2 text-sm leading-relaxed text-marinho/75">Você fala com quem constrói os seus agentes, e evolui com eles mês a mês.</p></div>
      </div>
    </div>
  </section>

  <!-- 7. Blog -->
  {posts.length > 0 && (
    <section class="py-24">
      <div class="container-site">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow">Blog</p>
            <h2 class="mt-4 text-3xl text-white sm:text-4xl">Para todos ∀</h2>
          </div>
          <a href="/blog" class="text-sm text-ciano hover:underline">Ver todos os textos →</a>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {posts.map((p) => (
            <a href={`/blog/${p.id}`} class="group rounded-2xl border border-lavanda/10 p-7 transition hover:border-lavanda/40">
              <p class="text-xs text-lavanda/50">{fmt.format(p.data.data)}{p.data.rascunho && ' · rascunho'}</p>
              <h3 class="mt-4 text-xl text-white group-hover:text-ciano">{p.data.titulo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-lavanda/70">{p.data.descricao}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTAFinal />
</Base>
