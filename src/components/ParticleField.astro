---
/**
 * Campo de partículas em onda (evolução da splash page de 2026),
 * agora sensível ao mouse/toque. Pausa fora da tela e respeita
 * "reduzir movimento" do sistema (desenha um quadro estático).
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<canvas data-particles class:list={['pointer-events-none absolute inset-0 h-full w-full', cls]} aria-hidden="true"></canvas>

<script>
  type P = { x: number; y: number; ox: number; oy: number };

  function iniciar(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const host = canvas.parentElement as HTMLElement;
    const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let w = 0, h = 0, dpr = 1, spacing = 18, cols = 0, rows = 0;
    let pts: P[] = [];
    let t = 0, raf = 0, visivel = true;
    const mouse = { x: -9999, y: -9999, alvoX: -9999, alvoY: -9999, ativo: false };

    function montar() {
      const r = host.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      spacing = w < 640 ? 16 : 18;
      cols = Math.ceil(w / spacing) + 3;
      rows = Math.ceil(h / spacing) + 3;
      pts = [];
      for (let c = 0; c < cols; c++)
        for (let r2 = 0; r2 < rows; r2++)
          pts.push({ x: 0, y: 0, ox: c * spacing - spacing, oy: r2 * spacing - spacing });
    }

    const RAIO = 140;

    function quadro() {
      ctx!.clearRect(0, 0, w, h);
      // suaviza o movimento do mouse
      mouse.x += (mouse.alvoX - mouse.x) * 0.12;
      mouse.y += (mouse.alvoY - mouse.y) * 0.12;

      for (const p of pts) {
        const { ox: x, oy: y } = p;
        const dx = Math.sin(y * 0.012 + t * 0.7) * 8 + Math.sin(y * 0.025 + x * 0.01 + t * 1.1) * 4 + Math.sin(y * 0.008 - t * 0.4) * 5;
        const dy = Math.cos(x * 0.012 + t * 0.5) * 6 + Math.cos(x * 0.02 - y * 0.015 + t * 0.8) * 3 + Math.cos(x * 0.008 + t * 0.3) * 4;
        let px = x + dx, py = y + dy;

        const onda = Math.sin(y * 0.012 + t * 0.7) * Math.cos(x * 0.012 + t * 0.5);
        let alpha = Math.max(0.08, Math.min(0.75, 0.38 + onda * 0.4));
        let size = 1.7;
        let perto = 0;

        if (mouse.ativo) {
          const mx = px - mouse.x, my = py - mouse.y;
          const d = Math.hypot(mx, my);
          if (d < RAIO) {
            perto = 1 - d / RAIO;
            const f = perto * perto * 22;
            px += (mx / (d || 1)) * f;
            py += (my / (d || 1)) * f;
            alpha = Math.min(1, alpha + perto * 0.7);
            size += perto * 1.1;
          }
        }

        // pervinca (100,110,180) → ciano (0,209,255) perto do cursor
        const rr = Math.round(100 - 100 * perto);
        const gg = Math.round(110 + 99 * perto);
        const bb = Math.round(180 + 75 * perto);
        ctx!.fillStyle = `rgba(${rr},${gg},${bb},${alpha})`;
        ctx!.fillRect(px - size / 2, py - size / 2, size, size);
      }
    }

    function loop() {
      if (!visivel) return;
      t += 0.012;
      quadro();
      raf = requestAnimationFrame(loop);
    }

    montar();
    if (reduzir) { quadro(); }
    else {
      loop();
      new IntersectionObserver(([e]) => {
        visivel = e.isIntersecting && !document.hidden;
        cancelAnimationFrame(raf);
        if (visivel) loop();
      }).observe(host);
      document.addEventListener('visibilitychange', () => {
        visivel = !document.hidden;
        cancelAnimationFrame(raf);
        if (visivel) loop();
      });
      host.addEventListener('pointermove', (e) => {
        const r = host.getBoundingClientRect();
        mouse.alvoX = e.clientX - r.left;
        mouse.alvoY = e.clientY - r.top;
        if (!mouse.ativo) { mouse.x = mouse.alvoX; mouse.y = mouse.alvoY; }
        mouse.ativo = true;
      });
      host.addEventListener('pointerleave', () => { mouse.ativo = false; });
    }

    let to = 0;
    new ResizeObserver(() => {
      clearTimeout(to);
      to = window.setTimeout(() => { montar(); if (reduzir) quadro(); }, 120);
    }).observe(host);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-particles]').forEach(iniciar);
</script>
